// =============================================================================
// HOTEL INVENTORY SYSTEM FOR IGP PATVEP HOSTEL AND UNIVERSITY CANTEEN
// File: bpsu_patvep_inventory_erd.dbml
// Paste into https://dbdiagram.io/d  (Import → DBML)
// Matches 02_tables.sql
// =============================================================================

Project bpsu_patvep_inventory {
  database_type: 'MySQL'
  Note: 'Hotel Inventory System for IGP PATVEP Hostel and University Canteen — BPSU Main Campus (MariaDB 10.4)'
}

Enum user_role {
  ADMIN
  STAFF_HOSTEL
  STAFF_CANTEEN
}

Enum location {
  HOSTEL
  CANTEEN
}

Enum item_category {
  FOOD_STAPLES
  MEAT_POULTRY
  BEVERAGES
  INGREDIENTS
  SUPPLIES_PACKAGING
  LINENS_BEDDING
  TOILETRIES
  ROOM_SUPPLIES
  CLEANING
}

Enum delivery_status {
  RECEIVED
  REJECTED
}

Enum transaction_type {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

Table users {
  user_id       int [pk, increment]
  username      varchar(50) [not null, unique]
  password_hash varchar(255) [not null, note: 'bcrypt']
  full_name     varchar(120) [not null]
  email         varchar(120) [not null, unique]
  phone         varchar(25)
  role          user_role [not null, note: 'STAFF_HOSTEL/STAFF_CANTEEN limited to own location']
  department    varchar(120)
  is_active     tinyint [not null, default: 1]
  created_at    datetime [not null]
  updated_at    datetime [not null]
  last_login_at datetime
}

Table suppliers {
  supplier_id         int [pk, increment]
  supplier_name       varchar(120) [not null, unique]
  contact_person      varchar(100)
  phone               varchar(25)
  email               varchar(120)
  address             text
  supplied_categories text
  notes               text
  is_active           tinyint [not null, default: 1]
  created_at          datetime [not null]
  updated_at          datetime [not null]
}

Table inventory_items {
  item_id               int [pk, increment]
  item_code             varchar(25) [not null, unique]
  item_name             varchar(120) [not null]
  location              location [not null]
  category              item_category [not null]
  unit                  varchar(30) [not null]
  current_stock         decimal(12,3) [not null, default: 0, note: 'trigger-maintained only']
  reorder_level         decimal(12,3) [not null, default: 10]
  critical_level        decimal(12,3) [not null, default: 0]
  unit_cost             decimal(10,2) [not null, default: 0]
  preferred_supplier_id int [ref: > suppliers.supplier_id]
  description           text
  is_active             tinyint [not null, default: 1]
  last_restocked_at     datetime
  created_at            datetime [not null]
  updated_at            datetime [not null]

  indexes {
    (location, item_name) [unique]
  }
}

Table deliveries {
  delivery_id         int [pk, increment]
  delivery_receipt_no varchar(60) [not null, unique]
  supplier_id         int [not null, ref: > suppliers.supplier_id]
  location            location [not null]
  status              delivery_status [not null, default: 'RECEIVED']
  received_at         datetime [not null]
  received_by         int [ref: > users.user_id]
  total_amount        decimal(12,2) [not null, default: 0, note: 'sum of lines, trigger-maintained']
  notes               text
  created_at          datetime [not null]
}

Table delivery_items {
  delivery_item_id int [pk, increment]
  delivery_id      int [not null, ref: > deliveries.delivery_id]
  item_id          int [not null, ref: > inventory_items.item_id]
  quantity         decimal(12,3) [not null]
  unit_cost        decimal(10,2) [not null]
  line_total       decimal(12,2) [note: 'generated: quantity × unit_cost']
  notes            text
}

Table inventory_transactions {
  txn_id           int [pk, increment]
  item_id          int [not null, ref: > inventory_items.item_id]
  transaction_type transaction_type [not null]
  quantity         decimal(12,3) [not null]
  unit_cost        decimal(10,2) [not null]
  total_cost       decimal(12,2) [note: 'generated: quantity × unit_cost']
  stock_before     decimal(12,3) [not null]
  stock_after      decimal(12,3) [not null]
  ref_type         varchar(30) [note: 'DELIVERY | CONSUMPTION | COUNT']
  ref_id           int
  reason           varchar(255) [not null]
  performed_by     int [ref: > users.user_id]
  transaction_date datetime [not null]
  notes            text
}

Table inventory_consumption {
  consumption_id   int [pk, increment]
  item_id          int [not null, ref: > inventory_items.item_id]
  quantity         decimal(12,3) [not null]
  purpose          varchar(120) [not null]
  notes            text
  recorded_by      int [ref: > users.user_id]
  consumption_date datetime [not null]
}

Table audit_logs {
  log_id            int [pk, increment]
  user_id           int [ref: > users.user_id]
  username_snapshot varchar(50) [not null]
  role_snapshot     varchar(30) [not null]
  action_type       varchar(60) [not null]
  target_entity     varchar(60) [not null]
  target_id         int
  description       text
  old_value         text
  new_value         text
  ip_address        varchar(45)
  logged_at         datetime [not null]
}

Table audit_logs_archive {
  log_id            int [pk, note: 'original audit_logs id']
  user_id           int [note: 'no FK on purpose']
  username_snapshot varchar(50) [not null]
  role_snapshot     varchar(30) [not null]
  action_type       varchar(60) [not null]
  target_entity     varchar(60) [not null]
  target_id         int
  description       text
  old_value         text
  new_value         text
  ip_address        varchar(45)
  logged_at         datetime [not null]
  archived_at       datetime [not null]
}
