# Python bytecode from scripts/
__pycache__/
*.py[cod]

# Local dev tooling: the no-cache server and its launch config are for this
# machine, not for the team or the turnover package
.claude/

# Editor and OS clutter
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Local database dumps: the schema in database/ is the source of truth,
# an export from someone's own XAMPP is not
*.sql.bak
*-export.sql
dump.sql

# Notes for teammates: kept locally, not part of the project
HANDOVER-*.md
